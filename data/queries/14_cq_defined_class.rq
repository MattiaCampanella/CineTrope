PREFIX : <http://example.org/cinetrope#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

# CQ: quali film appartengono alla classe definita AcclaimedBlockbuster (HermiT)?
SELECT ?film ?title ?vote ?revenue WHERE {
  ?film a :AcclaimedBlockbuster ; rdfs:label ?title .
  OPTIONAL { ?film :voteAverage ?vote }
  OPTIONAL { ?film :revenue ?revenue }
} ORDER BY DESC(?vote) ?title LIMIT 25
