PREFIX : <http://example.org/cinetrope#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

# Gerarchia dei generi modellati come individui.
SELECT ?genre ?genreLabel ?parent ?parentLabel
WHERE {
  ?genre a :Genere ;
         rdfs:label ?genreLabel ;
         :subGenreOf ?parent .
  ?parent a :Genere ;
          rdfs:label ?parentLabel .
  FILTER (?parent != ?genre)
}
ORDER BY ?genreLabel ?parentLabel
