@prefix : <http://example.org/cinetrope#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Ontologia radice: importa i moduli di data/ontology/schema/. I file vengono
# risolti localmente da cinetrope.etl (non serve rete). Vedi docs/ontology.md.

<http://example.org/cinetrope> a owl:Ontology ;
    owl:versionIRI <http://example.org/cinetrope/2.0.0> ;
    owl:versionInfo "2.0.0" ;
    rdfs:label "CineTrope - ontologia per raccomandazioni cinematografiche spiegabili"@it ,
        "CineTrope - ontology for explainable movie recommendations"@en ;
    rdfs:comment "Ontologia OWL 2 per collegare film, serie TV, persone, generi, tropi, paesi, lingue e franchise, mantenendo la provenienza delle asserzioni tramite named graph."@it ,
        "OWL 2 ontology linking films, TV series, people, genres, tropes, countries, languages and franchises, keeping assertion provenance via named graphs."@en ;
    dcterms:created "2026-11-17"^^xsd:date ;
    owl:imports <http://example.org/cinetrope/schema/classes> ,
        <http://example.org/cinetrope/schema/object-properties> ,
        <http://example.org/cinetrope/schema/data-properties> ,
        <http://example.org/cinetrope/schema/defined-classes> ,
        <http://example.org/cinetrope/schema/alignments> ,
        <http://example.org/cinetrope/schema/dl-axioms> .

# --- Fonti / named graph ----------------------------------------------------

:Wikidata a :Fonte ;
    rdfs:label "Wikidata"@en ;
    rdfs:comment "Metadati strutturati delle persone, per esempio le date di nascita."@it ,
        "Structured people metadata, e.g. birth dates."@en .

:DBpedia a :Fonte ;
    rdfs:label "DBpedia"@en ;
    rdfs:comment "Arricchimento delle persone, per esempio la data di nascita."@it ,
        "People enrichment, e.g. birth date."@en .

:TvTropes a :Fonte ;
    rdfs:label "TV Tropes"@en ;
    rdfs:comment "Tropi narrativi e annotazioni delle scene (non più popolata)."@it ,
        "Narrative tropes and scene annotations (no longer populated)."@en .

:TMDB a :Fonte ;
    rdfs:label "TMDB"@en ;
    rdfs:comment "Film, serie, cast, regia, generi, keyword e metadati importati da TMDB."@it ,
        "Films, series, cast, crew, genres, keywords and metadata imported from TMDB."@en .

:LocalAnalysis a :Fonte ;
    rdfs:label "Analisi locale"@it , "Local analysis"@en ;
    rdfs:comment "Generi e gerarchie curati nel dataset locale."@it ,
        "Genres and hierarchies curated in the local dataset."@en .

:Derived a :Fonte ;
    rdfs:label "Dati derivati"@it , "Derived data"@en ;
    rdfs:comment "Collaborazioni e co-presenze calcolate con query SPARQL durante l'ETL."@it ,
        "Collaborations and co-stars computed by SPARQL queries during the ETL."@en .

:Inferred a :Fonte ;
    rdfs:label "Inferenze"@it , "Inferences"@en ;
    rdfs:comment "Triple prodotte da OWL RL, regole CONSTRUCT di classificazione e SWRL."@it ,
        "Triples produced by OWL RL, CONSTRUCT classification rules and SWRL."@en .
