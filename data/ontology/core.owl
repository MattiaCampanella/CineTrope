  <rdf:Description rdf:about="http://example.org/cinetrope">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="en">CineTrope - OWL 2 DL Ontology</rdfs:label>
    <rdfs:label xml:lang="it">CineTrope - Ontologia OWL 2 DL</rdfs:label>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2026-11-21</dcterms:created>
    <dcterms:creator xml:lang="it">Progetto Universitario Semantic Web — Università di Catania</dcterms:creator>
    <dcterms:description xml:lang="it">Ontologia prodotta programmaticamente con rdflib: copre RDFS, OWL 2 DL (SROIQ(D)), Linked Open Data (owl:sameAs verso DBpedia/Wikidata) e regole SWRL DL-safe.</dcterms:description>
    <dcterms:title xml:lang="en">CineTrope Knowledge Graph Ontology</dcterms:title>
    <rdfs:comment xml:lang="it">Ontologia OWL 2 DL (SROIQ(D)) per raccomandazioni cinematografiche spiegabili. Corpus: top-100 film TMDB arricchiti da Wikidata e DBpedia. Reasoning: HermiT + SWRL DL-safe.</rdfs:comment>
    <owl:versionIRI rdf:resource="http://example.org/cinetrope/3.1.0"/>
    <owl:versionInfo>3.1.0</owl:versionInfo>
  </rdf:Description>
