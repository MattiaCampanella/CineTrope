@prefix : <http://example.org/cinetrope#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/cinetrope/schema/classes> a owl:Ontology ;
    rdfs:label "CineTrope - classi"@it , "CineTrope - classes"@en ;
    rdfs:comment "Gerarchia delle classi e disgiunzioni."@it , "Class hierarchy and disjointness."@en ;
    owl:versionInfo "2.0.0" .

:OperaAudiovisiva a owl:Class ;
    rdfs:label "Opera audiovisiva"@it , "Audiovisual work"@en ;
    rdfs:comment "Superclasse comune di film e serie TV."@it , "Common superclass of films and TV series."@en .

:Film a owl:Class ;
    rdfs:subClassOf :OperaAudiovisiva ;
    owl:disjointWith :SerieTV ;
    rdfs:label "Film"@it , "Film"@en ;
    rdfs:comment "Un film è un'opera audiovisiva e non può essere anche una serie TV."@it , "A film is an audiovisual work and cannot also be a TV series."@en .

:SerieTV a owl:Class ;
    rdfs:subClassOf :OperaAudiovisiva ;
    rdfs:label "Serie TV"@it , "TV series"@en .

:Movie a owl:Class ;
    owl:equivalentClass :Film ;
    rdfs:label "Movie"@en , "Movie"@it ;
    rdfs:comment "Allineamento terminologico usato da vocabolari esterni."@it , "Terminological alias used by external vocabularies."@en .

:TVSeries a owl:Class ;
    owl:equivalentClass :SerieTV ;
    rdfs:label "TV Series"@en , "TV Series"@it .

:Persona a owl:Class ;
    rdfs:label "Persona"@it , "Person"@en .

:Regista a owl:Class ;
    rdfs:subClassOf :Persona ;
    rdfs:label "Regista"@it , "Director"@en ;
    rdfs:comment "Non è disgiunta da Attore: la stessa persona può avere più ruoli."@it , "Not disjoint from Actor: one person may hold several roles."@en .

:Attore a owl:Class ;
    rdfs:subClassOf :Persona ;
    rdfs:label "Attore/Attrice"@it , "Actor"@en .

:Genere a owl:Class ;
    rdfs:label "Genere"@it , "Genre"@en ;
    rdfs:comment "I generi sono individui di questa classe collegati da :subGenreOf (nessun punning)."@it ,
        "Genres are individuals of this class linked by :subGenreOf (no punning)."@en .

:Tropo a owl:Class ;
    rdfs:label "Tropo narrativo"@it , "Narrative trope"@en .

:ElementoDescrittivo a owl:Class ;
    rdfs:label "Elemento descrittivo"@it , "Descriptive element"@en ;
    rdfs:comment "Keyword TMDB non classificata come tropo: ambientazione, personaggio, oggetto o contesto."@it ,
        "TMDB keyword not classified as a trope: setting, character, object or context."@en .

:Scena a owl:Class ;
    rdfs:label "Scena"@it , "Scene"@en .

:Fonte a owl:Class ;
    rdfs:label "Fonte"@it , "Source"@en ;
    rdfs:comment "Risorsa usata anche come nome del named graph che contiene le asserzioni."@it ,
        "Resource also used as the name of the named graph holding the assertions."@en .

:Paese a owl:Class ;
    rdfs:label "Paese"@it , "Country"@en .

:Lingua a owl:Class ;
    rdfs:label "Lingua"@it , "Language"@en .

:Studio a owl:Class ;
    rdfs:label "Studio di produzione"@it , "Production company"@en .

:Collezione a owl:Class ;
    rdfs:label "Collezione / franchise"@it , "Collection / franchise"@en ;
    rdfs:comment "Raggruppa film appartenenti allo stesso franchise (belongs_to_collection di TMDB)."@it ,
        "Groups films of the same franchise (TMDB belongs_to_collection)."@en .

[] a owl:AllDisjointClasses ;
    owl:members ( :OperaAudiovisiva :Persona :Genere :Tropo :ElementoDescrittivo
                  :Scena :Fonte :Paese :Lingua :Studio :Collezione ) .
