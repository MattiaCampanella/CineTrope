@prefix : <http://example.org/cinetrope#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/cinetrope/schema/alignments> a owl:Ontology ;
    rdfs:label "CineTrope - allineamenti"@it , "CineTrope - alignments"@en ;
    rdfs:comment "Allineamenti a schema.org, DBpedia, FOAF e Wikidata."@it ,
        "Alignments to schema.org, DBpedia, FOAF and Wikidata."@en ;
    owl:versionInfo "2.0.0" .

:Film owl:equivalentClass schema:Movie , dbo:Film , wd:Q11424 .
:SerieTV owl:equivalentClass schema:TVSeries , wd:Q5398426 .
:Persona owl:equivalentClass foaf:Person , schema:Person .
:Genere rdfs:seeAlso wd:Q483394 .
:Paese owl:equivalentClass schema:Country .
:Studio owl:equivalentClass schema:Organization .
:Collezione rdfs:seeAlso wd:Q1198166 .

:directedBy owl:equivalentProperty schema:director , dbo:director , wdt:P57 .
:starring owl:equivalentProperty schema:actor , dbo:starring , wdt:P161 .
:releaseDate owl:equivalentProperty schema:datePublished .
:birthDate owl:equivalentProperty schema:birthDate , dbo:birthDate .
:hasGenre owl:equivalentProperty schema:genre .
:runtime owl:equivalentProperty schema:duration .
:originCountry owl:equivalentProperty schema:countryOfOrigin .
:title rdfs:seeAlso schema:name .
