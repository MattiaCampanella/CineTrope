@prefix : <http://example.org/cinetrope#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Classi definite (equivalentClass). Quelle classificabili da OWL RL (hasValue,
# someValuesFrom su classe nominata) sono inferite da owlrl; le altre
# (cardinalità qualificate, datatype restriction, classi con ruoli annidati)
# sono dichiarate qui e materializzate da data/queries/rules/*.rq.

<http://example.org/cinetrope/schema/defined-classes> a owl:Ontology ;
    rdfs:label "CineTrope - classi definite"@it , "CineTrope - defined classes"@en ;
    owl:versionInfo "2.0.0" .

:MindBender a owl:Class ;
    rdfs:subClassOf :Film ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        :Film
        [ a owl:Restriction ; owl:onProperty :hasTrope ; owl:hasValue :UnreliableNarrator ]
        [ a owl:Restriction ; owl:onProperty :hasTrope ; owl:hasValue :TwistEnding ] ) ] ;
    rdfs:label "Mind-bender"@it , "Mind-bender"@en ;
    rdfs:comment "Film con narratore inaffidabile e finale a sorpresa (OWL RL hasValue + regola SWRL MindBenderRule)."@it ,
        "Film with an unreliable narrator and a twist ending (OWL RL hasValue + SWRL rule MindBenderRule)."@en .

:SpeculativeFilm a owl:Class ;
    rdfs:subClassOf :Film ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        :Film
        [ a owl:Restriction ; owl:onProperty :hasAncestorGenre ; owl:hasValue :SpeculativeFiction ] ) ] ;
    rdfs:label "Film di narrativa speculativa"@it , "Speculative-fiction film"@en ;
    rdfs:comment "Film con un genere discendente da SpeculativeFiction, via property chain hasGenre ∘ subGenreOf."@it ,
        "Film whose genre descends from SpeculativeFiction, via chain hasGenre ∘ subGenreOf."@en .

:CollectionFilm a owl:Class ;
    rdfs:subClassOf :Film ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        :Film
        [ a owl:Restriction ; owl:onProperty :partOfCollection ; owl:someValuesFrom :Collezione ] ) ] ;
    rdfs:label "Film di un franchise"@it , "Franchise film"@en ;
    rdfs:comment "Film che fa parte di una collezione (someValuesFrom su classe nominata, inferito da OWL RL)."@it ,
        "Film that is part of a collection (someValuesFrom on a named class, inferred by OWL RL)."@en .

:SequelFilm a owl:Class ;
    rdfs:subClassOf :Film ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        :Film
        [ a owl:Restriction ; owl:onProperty :sequelOf ; owl:someValuesFrom :Film ] ) ] ;
    rdfs:label "Sequel"@it , "Sequel"@en ;
    rdfs:comment "Film che è sequel di un altro film (inferito da OWL RL)."@it ,
        "Film that is a sequel of another film (inferred by OWL RL)."@en .

:MultiGenreFilm a owl:Class ;
    rdfs:subClassOf :Film ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        :Film
        [ a owl:Restriction ; owl:onProperty :hasGenre ;
          owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass :Genere ] ) ] ;
    rdfs:label "Film multigenere"@it , "Multi-genre film"@en ;
    rdfs:comment "Almeno tre generi (cardinalità qualificata: regola rules/multi_genre.rq)."@it ,
        "At least three genres (qualified cardinality: rules/multi_genre.rq)."@en .

:EnsembleFilm a owl:Class ;
    rdfs:subClassOf :Film ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        :Film
        [ a owl:Restriction ; owl:onProperty :starring ;
          owl:minQualifiedCardinality "10"^^xsd:nonNegativeInteger ; owl:onClass :Attore ] ) ] ;
    rdfs:label "Film corale"@it , "Ensemble film"@en ;
    rdfs:comment "Almeno dieci attori accreditati (rules/ensemble.rq)."@it ,
        "At least ten credited actors (rules/ensemble.rq)."@en .

:AuteurFilm a owl:Class ;
    rdfs:subClassOf :Film ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        :Film
        [ a owl:Restriction ; owl:onProperty :directedBy ; owl:someValuesFrom
            [ a owl:Restriction ; owl:onProperty :hasFrequentCollaborator ; owl:someValuesFrom :Persona ] ] ) ] ;
    rdfs:label "Film di un regista con collaboratori fissi"@it , "Film by a director with regular collaborators"@en ;
    rdfs:comment "Regista con almeno un collaboratore frequente (rules/auteur.rq)."@it ,
        "Director with at least one frequent collaborator (rules/auteur.rq)."@en .

:AcclaimedFilm a owl:Class ;
    rdfs:subClassOf :Film ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        :Film
        [ a owl:Restriction ; owl:onProperty :voteAverage ; owl:someValuesFrom
            [ a rdfs:Datatype ; owl:onDatatype xsd:decimal ;
              owl:withRestrictions ( [ xsd:minInclusive "7.5"^^xsd:decimal ] ) ] ] ) ] ;
    rdfs:label "Film acclamato"@it , "Acclaimed film"@en ;
    rdfs:comment "voteAverage >= 7.5 (datatype restriction; rules/acclaimed.rq). Richiede il reimport TMDB."@it ,
        "voteAverage >= 7.5 (datatype restriction; rules/acclaimed.rq). Requires TMDB re-import."@en .

:Blockbuster a owl:Class ;
    rdfs:subClassOf :Film ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        :Film
        [ a owl:Restriction ; owl:onProperty :revenue ; owl:someValuesFrom
            [ a rdfs:Datatype ; owl:onDatatype xsd:integer ;
              owl:withRestrictions ( [ xsd:minInclusive 500000000 ] ) ] ] ) ] ;
    rdfs:label "Blockbuster"@it , "Blockbuster"@en ;
    rdfs:comment "revenue >= 500 milioni USD (rules/blockbuster.rq). Richiede il reimport TMDB."@it ,
        "revenue >= 500M USD (rules/blockbuster.rq). Requires TMDB re-import."@en .

:EpicFilm a owl:Class ;
    rdfs:subClassOf :Film ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        :Film
        [ a owl:Restriction ; owl:onProperty :runtime ; owl:someValuesFrom
            [ a rdfs:Datatype ; owl:onDatatype xsd:integer ;
              owl:withRestrictions ( [ xsd:minInclusive 150 ] ) ] ] ) ] ;
    rdfs:label "Film kolossal"@it , "Epic-length film"@en ;
    rdfs:comment "runtime >= 150 minuti (rules/epic.rq). Richiede il reimport TMDB."@it ,
        "runtime >= 150 minutes (rules/epic.rq). Requires TMDB re-import."@en .

:ClassicFilm a owl:Class ;
    rdfs:subClassOf :Film ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        :Film
        [ a owl:Restriction ; owl:onProperty :releaseYear ; owl:someValuesFrom
            [ a rdfs:Datatype ; owl:onDatatype xsd:gYear ;
              owl:withRestrictions ( [ xsd:maxInclusive "1999"^^xsd:gYear ] ) ] ] ) ] ;
    rdfs:label "Film classico"@it , "Classic film"@en ;
    rdfs:comment "Uscito entro il 1999 (rules/classic.rq)."@it , "Released in or before 1999 (rules/classic.rq)."@en .

:ItalianFilm a owl:Class ;
    rdfs:subClassOf :Film ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        :Film
        [ a owl:Restriction ; owl:onProperty :originCountry ; owl:hasValue :Country_IT ] ) ] ;
    rdfs:label "Film italiano"@it , "Italian film"@en ;
    rdfs:comment "Paese di origine Italia (hasValue su individuo nominale). Richiede il reimport TMDB."@it ,
        "Origin country Italy (hasValue on a nominal). Requires TMDB re-import."@en .

:Country_IT a :Paese ;
    rdfs:label "Italia"@it , "Italy"@en ;
    :isoCode "IT" .
