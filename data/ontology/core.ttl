ct:Auteur a owl:Class ;
    rdfs:label "Auteur director"@en,
        "Regista auteur"@it ;
    rdfs:comment "Regista che ha diretto almeno un AcclaimedFilm: Regista ⊓ (directorOf some AcclaimedFilm). Combina proprietà inversa (directorOf = directedBy⁻¹) e classe definita."@it ;
    rdfs:subClassOf ct:Regista ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ct:Regista [ a owl:Restriction ;
                        owl:onProperty ct:directorOf ;
                        owl:someValuesFrom ct:AcclaimedFilm ] ) ] .

