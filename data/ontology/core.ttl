ct:EnsembleFilm a owl:Class ;
    rdfs:label "Ensemble film"@en,
        "Film corale"@it ;
    rdfs:comment "Film con almeno 7 attori accreditati (castSize ≥ 7). Classificato da HermiT."@it ;
    rdfs:subClassOf ct:Film ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ct:Film [ a owl:Restriction ;
                        owl:onProperty ct:castSize ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 7 ] ) ] ] ) ] .

ct:EpicFilm a owl:Class ;
    rdfs:label "Epic-length film"@en,
        "Film kolossal"@it ;
    rdfs:comment "Film con durata ≥ 150 minuti (datatype restriction). Classificato da HermiT."@it ;
    rdfs:subClassOf ct:Film ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ct:Film [ a owl:Restriction ;
                        owl:onProperty ct:runtime ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 150 ] ) ] ] ) ] .

