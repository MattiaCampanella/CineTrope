ct:Genere a owl:Class ;
    rdfs:label "Film genre"@en,
        "Genere cinematografico"@it ;
    rdfs:comment "Genere cinematografico modellato come individuo (con gerarchia transitiva subGenreOf)."@it .

ct:Drama a ct:Genere,
        owl:NamedIndividual ;
    rdfs:label "Dramma"@it ;
    skos:prefLabel "Dramma"@it .

ct:Horror a ct:Genere,
        owl:NamedIndividual ;
    rdfs:label "Horror"@it ;
    ct:subGenreOf ct:SpeculativeFiction ;
    skos:prefLabel "Horror"@it .

ct:Paese a owl:Class ;
    rdfs:label "Country"@en,
        "Paese"@it ;
    rdfs:comment "Paese di produzione cinematografica."@it ;
    owl:equivalentClass schema:Country .

ct:ScienceFiction a ct:Genere,
        owl:NamedIndividual ;
    rdfs:label "Fantascienza"@it ;
    ct:subGenreOf ct:SpeculativeFiction ;
    skos:prefLabel "Fantascienza"@it .

ct:Adventure a ct:Genere,
        owl:NamedIndividual ;
    rdfs:label "Avventura"@it ;
    ct:subGenreOf ct:Action ;
    skos:prefLabel "Avventura"@it .

ct:Action a ct:Genere,
        owl:NamedIndividual ;
    rdfs:label "Azione"@it ;
    skos:prefLabel "Azione"@it .

ct:Thriller a ct:Genere,
        owl:NamedIndividual ;
    rdfs:label "Thriller"@it ;
    skos:prefLabel "Thriller"@it .

ct:OperaAudiovisiva a owl:Class ;
    rdfs:label "Audiovisual work"@en,
        "Opera audiovisiva"@it ;
    rdfs:comment "Superclasse comune di Film e SerieTV (partizionata da owl:disjointUnionOf)."@it ;
    owl:disjointUnionOf ( ct:Film ct:SerieTV ) .

ct:Country_US a ct:Paese,
        owl:NamedIndividual ;
    rdfs:label "United States of America"@en ;
    ct:countryIsoCode "US"^^xsd:string .

ct:Lang_en a ct:Lingua,
        owl:NamedIndividual ;
    rdfs:label "English"@en,
        "Inglese"@it ;
    ct:languageIsoCode "en"^^xsd:string .

ct:Regista a owl:Class ;
    rdfs:label "Director"@en,
        "Regista"@it ;
    rdfs:comment "Persona che ha diretto almeno un'opera."@it ;
    rdfs:subClassOf ct:Persona ;
    owl:equivalentClass dbo:MovieDirector .

ct:Film a owl:Class ;
    rdfs:label "Film"@en,
        "Film"@it ;
    rdfs:comment "Un film cinematografico."@it ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ct:Genere ;
            owl:onProperty ct:hasGenre ],
        [ a owl:Restriction ;
            owl:allValuesFrom ct:Regista ;
            owl:onProperty ct:directedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom ct:Paese ;
            owl:onProperty ct:originCountry ],
        ct:OperaAudiovisiva ;
    owl:disjointWith ct:SerieTV ;
    owl:equivalentClass dbo:Film,
        schema:Movie,
        wd:Q11424 .

ct:Studio a owl:Class ;
    rdfs:label "Production company"@en,
        "Studio di produzione"@it ;
    rdfs:comment "Casa o studio di produzione."@it ;
    owl:equivalentClass schema:Organization .

ct:Tropo a owl:Class ;
    rdfs:label "Narrative trope"@en,
        "Tropo narrativo"@it ;
    rdfs:comment "Keyword TMDB usata come tropo narrativo condivisibile tra film."@it .

ct:Attore a owl:Class ;
    rdfs:label "Actor"@en,
        "Attore/Attrice"@it ;
    rdfs:comment "Persona che ha recitato in almeno un'opera."@it ;
    rdfs:subClassOf ct:Persona ;
    owl:equivalentClass dbo:Actor .

ct:Persona a owl:Class ;
    rdfs:label "Person"@en,
        "Persona"@it ;
    rdfs:comment "Persona coinvolta nella produzione cinematografica."@it ;
    owl:equivalentClass dbo:Person,
        schema:Person,
        foaf:Person .

[] a owl:AllDifferent ;
    owl:distinctMembers ( ct:TMDB1003596 ct:TMDB101299 ct:TMDB1300968 ct:TMDB1368337 ct:TMDB1375441 ct:TMDB1381071 ct:TMDB155 ct:TMDB157336 ct:TMDB1765072 ct:TMDB27205 ct:TMDB299534 ct:TMDB299536 ct:TMDB940721 ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( ct:Action ct:Adventure ct:Animation ct:Comedy ct:Crime ct:Drama ct:Family ct:Fantasy ct:Horror ct:Music ct:Mystery ct:Romance ct:ScienceFiction ct:SpeculativeFiction ct:Thriller ct:War ct:Western ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ct:OperaAudiovisiva ct:Persona ct:Genere ct:Tropo ct:Premio ct:Paese ct:Lingua ct:Studio ct:Collezione ct:Fonte ) .

