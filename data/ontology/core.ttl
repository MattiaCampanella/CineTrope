ct:PremioFilm a owl:Class ;
    rdfs:label "Acclaimed profitable ensemble film"@en,
        "Film corale acclamato e profittevole"@it ;
    rdfs:comment "Film che soddisfa congiuntamente EnsembleFilm, AcclaimedFilm e ProfitableFilm (chaining SWRL EnsembleAwardRule)."@it ;
    rdfs:subClassOf ct:Film .

ct:PriyaKansara a ct:Attore,
        ct:Persona,
        owl:NamedIndividual ;
    rdfs:label "Priya Kansara" .

ct:ProfitableFilm a owl:Class ;
    rdfs:label "Profitable film"@en,
        "Film profittevole"@it ;
    rdfs:comment "Film con incasso almeno doppio rispetto al budget (roi ≥ 2.0). Disgiunto da BoxOfficeFlop."@it ;
    rdfs:subClassOf ct:Film ;
    owl:disjointWith ct:BoxOfficeFlop ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ct:Film [ a owl:Restriction ;
                        owl:onProperty ct:roi ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:decimal ;
                                owl:withRestrictions ( [ xsd:minInclusive 2.0 ] ) ] ] ) ] .

