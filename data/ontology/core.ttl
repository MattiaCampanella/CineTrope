    rdfs:label "includes"@en,
        "comprende"@it ;
    rdfs:domain ct:Collezione ;
    rdfs:range ct:OperaAudiovisiva ;
    owl:inverseOf ct:partOfCollection .

ct:hasSequel a owl:ObjectProperty,
