    rdfs:label "has sequel"@en,
        "ha come sequel"@it ;
    rdfs:domain ct:OperaAudiovisiva ;
    rdfs:range ct:OperaAudiovisiva ;
    owl:inverseOf ct:sequelOf .

ct:hasTrope a owl:ObjectProperty ;
    rdfs:label "has trope"@en,
        "usa il tropo"@it ;
