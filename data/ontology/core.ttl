ct:BoxOfficeFlop a owl:Class ;
    rdfs:label "Box-office flop"@en,
        "Flop al botteghino"@it ;
    rdfs:comment "Film con budget ≥ 20M USD e 0 < roi < 1.0 (doppia datatype restriction minExclusive/maxExclusive). Disgiunto da ProfitableFilm."@it ;
    rdfs:subClassOf ct:Film ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ct:Film [ a owl:Restriction ;
                        owl:onProperty ct:budget ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 20000000 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty ct:roi ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:decimal ;
                                owl:withRestrictions ( [ xsd:minExclusive 0.0 ] [ xsd:maxExclusive 1.0 ] ) ] ] ) ] .

