ct:AwardedFilm a owl:Class ;
    rdfs:label "Oscar-awarded film"@en,
        "Film premiato Oscar"@it ;
    rdfs:comment "Film vincitore del premio Oscar per il Miglior Film (owl:hasValue). Dati da Wikidata."@it ;
    rdfs:subClassOf ct:Film ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ct:Film [ a owl:Restriction ;
                        owl:hasValue "OSCAR_BEST_PICTURE"^^xsd:string ;
                        owl:onProperty ct:awardCode ] ) ] .

