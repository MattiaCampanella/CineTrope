ct:VersatileAuteurRule a swrl:Imp ;
    rdfs:label "VersatileAuteurRule"^^xsd:string ;
    swrla:isRuleEnabled true ;
    rdfs:comment "Regista di almeno un AcclaimedFilm che ha diretto 2 film distinti di 2 generi distinti → VersatileAuteur."@it ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 <urn:swrl:var#d> ;
                    swrl:classPredicate ct:Regista ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:IndividualPropertyAtom ;
                            swrl:argument1 <urn:swrl:var#d> ;
                            swrl:argument2 <urn:swrl:var#f1> ;
                            swrl:propertyPredicate ct:directorOf ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:ClassAtom ;
                                    swrl:argument1 <urn:swrl:var#f1> ;
                                    swrl:classPredicate ct:AcclaimedFilm ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                            swrl:argument1 <urn:swrl:var#f1> ;
                                            swrl:argument2 <urn:swrl:var#g1> ;
                                            swrl:propertyPredicate ct:hasGenre ] ;
                                    rdf:rest [ a swrl:AtomList ;
                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                    swrl:argument1 <urn:swrl:var#d> ;
                                                    swrl:argument2 <urn:swrl:var#f2> ;
                                                    swrl:propertyPredicate ct:directorOf ] ;
                                            rdf:rest [ a swrl:AtomList ;
                                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                                            swrl:argument1 <urn:swrl:var#f2> ;
                                                            swrl:argument2 <urn:swrl:var#g2> ;
                                                            swrl:propertyPredicate ct:hasGenre ] ;
                                                    rdf:rest [ a swrl:AtomList ;
                                                            rdf:first [ a swrl:DifferentIndividualsAtom ;
                                                                    swrl:argument1 <urn:swrl:var#f1> ;
                                                                    swrl:argument2 <urn:swrl:var#f2> ] ;
                                                            rdf:rest [ a swrl:AtomList ;
                                                                    rdf:first [ a swrl:DifferentIndividualsAtom ;
                                                                            swrl:argument1 <urn:swrl:var#g1> ;
                                                                            swrl:argument2 <urn:swrl:var#g2> ] ;
                                                                    rdf:rest () ] ] ] ] ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 <urn:swrl:var#d> ;
                    swrl:classPredicate ct:VersatileAuteur ] ;
            rdf:rest () ] .

ct:VeteranAuteur a owl:Class ;
    rdfs:label "Veteran auteur"@en,
        "Auteur veterano"@it ;
    rdfs:comment "Regista che è sia Auteur (dati TMDB) sia VeteranDirector (dati DBpedia): intersezione cross-source."@it ;
    rdfs:subClassOf ct:Auteur ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ct:Auteur ct:VeteranDirector ) ] .

ct:Wikidata a ct:Fonte,
        owl:NamedIndividual ;
    rdfs:label "Wikidata" .

ct:actedIn a owl:ObjectProperty ;
    rdfs:label "acted in"@en,
        "ha recitato in"@it ;
    rdfs:domain ct:Attore ;
    rdfs:range ct:OperaAudiovisiva ;
    rdfs:subPropertyOf ct:contributedTo ;
    owl:inverseOf ct:starring .

ct:backdropPath a owl:DatatypeProperty ;
    rdfs:label "backdrop path"@en,
        "percorso sfondo"@it ;
    rdfs:domain ct:OperaAudiovisiva ;
    rdfs:range xsd:string .

ct:birthDate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "birth date"@en,
        "data di nascita"@it ;
    rdfs:domain ct:Persona ;
    rdfs:range xsd:string ;
    owl:equivalentProperty dbo:birthDate,
        schema:birthDate .

ct:coStarsWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "co-stars with"@en,
        "ha recitato insieme a"@it ;
    rdfs:comment "Inferita dalla regola SWRL RecurrentCoStarRule (diamante tra attori su ≥ 2 film)."@it ;
    rdfs:domain ct:Attore ;
    rdfs:range ct:Attore ;
    rdfs:subPropertyOf ct:collaboratedWith .

ct:countryIsoCode a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "country ISO code"@en,
        "codice ISO paese"@it ;
    rdfs:domain ct:Paese ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf ct:isoCode .

ct:directSequelOf a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "direct sequel of"@en,
        "sequel diretto di"@it ;
    rdfs:comment "Ruolo semplice (Asymmetric + Irreflexive + Functional) sottoproprietà del transitivo sequelOf."@it ;
    rdfs:domain ct:OperaAudiovisiva ;
    rdfs:range ct:OperaAudiovisiva ;
    rdfs:subPropertyOf ct:sequelOf .

ct:displayTitle a owl:AnnotationProperty ;
    rdfs:label "display title"@en,
        "titolo visualizzato"@it ;
    rdfs:comment "Sottoproprietà di rdfs:label (pattern Lezione 10 ActorsFilms) tipizzata come owl:AnnotationProperty per rispettare la separazione OWL 2 DL tra annotazioni e data property."@it ;
    rdfs:subPropertyOf rdfs:label .

ct:frequentCollaboration a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "frequent collaboration"@en,
        "collaborazione frequente"@it ;
    rdfs:domain ct:Persona ;
    rdfs:range ct:Persona ;
    rdfs:subPropertyOf ct:collaboratedWith .

ct:hasAncestorGenre a owl:ObjectProperty ;
    rdfs:label "has ancestor genre"@en,
        "genere antenato"@it ;
    rdfs:comment "Inferita via property chain hasGenre ∘ subGenreOf."@it ;
    rdfs:domain ct:OperaAudiovisiva ;
    rdfs:range ct:Genere ;
    owl:propertyChainAxiom ( ct:hasGenre ct:subGenreOf ) .

ct:hasAward a owl:ObjectProperty ;
    rdfs:label "has award"@en,
        "ha ricevuto il premio"@it ;
    rdfs:comment "Materializzato dalla query Wikidata (premi Oscar Best Picture)."@it ;
    rdfs:domain ct:OperaAudiovisiva ;
    rdfs:range ct:Premio ;
    owl:equivalentProperty schema:award,
        wdt:P166 .

