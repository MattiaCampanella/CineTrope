ct:AcclaimedFilm a owl:Class ;
    rdfs:label "Acclaimed film"@en,
        "Film acclamato"@it ;
    rdfs:comment "Film con voto medio TMDB ≥ 7.5 (datatype restriction xsd:minInclusive). Classificato da HermiT."@it ;
    rdfs:subClassOf ct:Film ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ct:Film [ a owl:Restriction ;
                        owl:onProperty ct:voteAverage ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:decimal ;
                                owl:withRestrictions ( [ xsd:minInclusive 7.5 ] ) ] ] ) ] .

