ct:Blockbuster a owl:Class ;
    rdfs:label "Blockbuster"@en,
        "Blockbuster"@it ;
    rdfs:comment "Film con incasso ≥ 500 milioni USD (datatype restriction xsd:minInclusive). Classificato da HermiT."@it ;
    rdfs:subClassOf ct:Film ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ct:Film [ a owl:Restriction ;
                        owl:onProperty ct:revenue ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 500000000 ] ) ] ] ) ] .

