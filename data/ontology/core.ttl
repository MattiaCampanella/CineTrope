    rdfs:range xsd:integer .

ct:sameDirectorAs a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "same director as"@en,
        "stesso regista di"@it ;
    rdfs:comment "Inferita via property chain directedBy ∘ directorOf."@it ;
    rdfs:domain ct:OperaAudiovisiva ;
    rdfs:range ct:OperaAudiovisiva ;
    rdfs:subPropertyOf ct:relatedFilm ;
    owl:propertyChainAxiom ( ct:directedBy ct:directorOf ) .

