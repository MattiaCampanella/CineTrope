@prefix ct: <http://example.org/cinetrope#> .
@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix dbr: <http://dbpedia.org/resource/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix swrl: <http://www.w3.org/2003/11/swrl#> .
@prefix swrla: <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/cinetrope> a owl:Ontology ;
    rdfs:label "CineTrope - OWL 2 DL Ontology"@en,
        "CineTrope - Ontologia OWL 2 DL"@it ;
    dcterms:created "2026-11-21"^^xsd:string ;
    dcterms:creator "Progetto Universitario Semantic Web — Università di Catania"@it ;
    dcterms:description "Ontologia prodotta programmaticamente con rdflib: copre RDFS, OWL 2 DL (SROIQ(D)), Linked Open Data (owl:sameAs verso DBpedia/Wikidata) e regole SWRL DL-safe."@it ;
    dcterms:title "CineTrope Knowledge Graph Ontology"@en ;
    rdfs:comment "Ontologia OWL 2 DL (SROIQ(D)) per raccomandazioni cinematografiche spiegabili. Corpus: top-100 film TMDB arricchiti da Wikidata e DBpedia. Reasoning: HermiT + SWRL DL-safe."@it ;
    owl:versionIRI <http://example.org/cinetrope/3.1.0> ;
    owl:versionInfo "3.1.0" .

ct:AcclaimedBlockbuster a owl:Class ;
    rdfs:label "Acclaimed blockbuster"@en,
        "Blockbuster acclamato"@it ;
    rdfs:comment "Intersezione di due classi definite: AcclaimedFilm ⊓ Blockbuster (chiusura transitiva HermiT)."@it ;
    rdfs:subClassOf ct:Film ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ct:AcclaimedFilm ct:Blockbuster ) ] .

ct:CollectionFilm a owl:Class ;
    rdfs:label "Franchise film"@en,
        "Film di un franchise"@it ;
    rdfs:comment "Film che fa parte di una collezione (someValuesFrom su classe nominata). Inferito da HermiT."@it ;
    rdfs:subClassOf ct:Film ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ct:Film [ a owl:Restriction ;
                        owl:onProperty ct:partOfCollection ;
                        owl:someValuesFrom ct:Collezione ] ) ] .

ct:DBpedia a ct:Fonte,
        owl:NamedIndividual ;
    rdfs:label "DBpedia" .

ct:Derived a ct:Fonte,
        owl:NamedIndividual ;
    rdfs:label "Dati derivati" .

ct:EnsembleAwardRule a swrl:Imp ;
    rdfs:label "EnsembleAwardRule"^^xsd:string ;
    swrla:isRuleEnabled true ;
    rdfs:comment "Film che è simultaneamente EnsembleFilm, AcclaimedFilm e ProfitableFilm → PremioFilm (chaining OWL 2 DL → SWRL)."@it ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 <urn:swrl:var#f> ;
                    swrl:classPredicate ct:Film ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:ClassAtom ;
                            swrl:argument1 <urn:swrl:var#f> ;
                            swrl:classPredicate ct:EnsembleFilm ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:ClassAtom ;
                                    swrl:argument1 <urn:swrl:var#f> ;
                                    swrl:classPredicate ct:AcclaimedFilm ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:ClassAtom ;
                                            swrl:argument1 <urn:swrl:var#f> ;
                                            swrl:classPredicate ct:ProfitableFilm ] ;
                                    rdf:rest () ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 <urn:swrl:var#f> ;
                    swrl:classPredicate ct:PremioFilm ] ;
            rdf:rest () ] .

ct:FrequentCollaboratorRule a swrl:Imp ;
    rdfs:label "FrequentCollaboratorRule"^^xsd:string ;
    swrla:isRuleEnabled true ;
    rdfs:comment "Regista e attore che collaborano su almeno 2 film distinti → hasFrequentCollaborator (ciclo a diamante non esprimibile in OWL 2 DL)."@it ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 <urn:swrl:var#f1> ;
                    swrl:classPredicate ct:Film ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:ClassAtom ;
                            swrl:argument1 <urn:swrl:var#f2> ;
                            swrl:classPredicate ct:Film ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:DifferentIndividualsAtom ;
                                    swrl:argument1 <urn:swrl:var#f1> ;
                                    swrl:argument2 <urn:swrl:var#f2> ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                            swrl:argument1 <urn:swrl:var#f1> ;
                                            swrl:argument2 <urn:swrl:var#d> ;
                                            swrl:propertyPredicate ct:directedBy ] ;
                                    rdf:rest [ a swrl:AtomList ;
                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                    swrl:argument1 <urn:swrl:var#f2> ;
                                                    swrl:argument2 <urn:swrl:var#d> ;
                                                    swrl:propertyPredicate ct:directedBy ] ;
                                            rdf:rest [ a swrl:AtomList ;
                                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                                            swrl:argument1 <urn:swrl:var#f1> ;
                                                            swrl:argument2 <urn:swrl:var#a> ;
                                                            swrl:propertyPredicate ct:starring ] ;
                                                    rdf:rest [ a swrl:AtomList ;
                                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                                    swrl:argument1 <urn:swrl:var#f2> ;
                                                                    swrl:argument2 <urn:swrl:var#a> ;
                                                                    swrl:propertyPredicate ct:starring ] ;
                                                            rdf:rest () ] ] ] ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 <urn:swrl:var#d> ;
                    swrl:argument2 <urn:swrl:var#a> ;
                    swrl:propertyPredicate ct:hasFrequentCollaborator ] ;
            rdf:rest () ] .

ct:Inferred a ct:Fonte,
        owl:NamedIndividual ;
    rdfs:label "Inferenze" .

ct:Movie a owl:Class ;
    rdfs:label "Movie"@en,
        "Film (alias)"@it ;
    rdfs:comment "Alias equivalente a ct:Film (owl:equivalentClass tra classi nominate, stile Lezione 12)."@it ;
    owl:equivalentClass ct:Film .

ct:MultiGenreFilm a owl:Class ;
    rdfs:label "Multi-genre film"@en,
        "Film multigenere"@it ;
    rdfs:comment "Film appartenente ad almeno 3 generi distinti (minQualifiedCardinality + owl:AllDifferent sotto OWA)."@it ;
    rdfs:subClassOf ct:Film ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ct:Film [ a owl:Restriction ;
                        owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ;
                        owl:onClass ct:Genere ;
                        owl:onProperty ct:hasGenre ] ) ] .

ct:NotableFilm a owl:Class ;
    rdfs:label "Notable film"@en,
        "Film notevole"@it ;
    rdfs:comment "Unione chiusa di classi definite (owl:unionOf): AcclaimedFilm ⊔ AwardedFilm ⊔ Blockbuster."@it ;
    rdfs:subClassOf ct:Film ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( ct:AcclaimedFilm ct:AwardedFilm ct:Blockbuster ) ] .

ct:Ontology a ct:Fonte,
        owl:NamedIndividual ;
    rdfs:label "Ontologia" .

ct:SciFi a ct:Genere,
        owl:NamedIndividual ;
    rdfs:label "Sci-Fi"@en ;
    owl:sameAs ct:ScienceFiction ;
    skos:altLabel "Sci-Fi"@en .

ct:SelfDirectedRoleRule a swrl:Imp ;
    rdfs:label "SelfDirectedRoleRule"^^xsd:string ;
    swrla:isRuleEnabled true ;
    rdfs:comment "Persona che dirige e interpreta lo stesso film → AutoreInterprete (role conjunction non esprimibile in OWL 2 DL)."@it ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 <urn:swrl:var#f> ;
                    swrl:classPredicate ct:Film ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:IndividualPropertyAtom ;
                            swrl:argument1 <urn:swrl:var#f> ;
                            swrl:argument2 <urn:swrl:var#p> ;
                            swrl:propertyPredicate ct:directedBy ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                    swrl:argument1 <urn:swrl:var#f> ;
                                    swrl:argument2 <urn:swrl:var#p> ;
                                    swrl:propertyPredicate ct:starring ] ;
                            rdf:rest () ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 <urn:swrl:var#p> ;
                    swrl:classPredicate ct:AutoreInterprete ] ;
            rdf:rest () ] .

ct:SequelDirectorRule a swrl:Imp ;
    rdfs:label "SequelDirectorRule"^^xsd:string ;
    swrla:isRuleEnabled true ;
    rdfs:comment "Regista che dirige sia un film sia un suo sequel (anche transitivo) → SequelDirector (triangolo non esprimibile in OWL 2 DL)."@it ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 <urn:swrl:var#f1> ;
                    swrl:classPredicate ct:Film ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:ClassAtom ;
                            swrl:argument1 <urn:swrl:var#f2> ;
                            swrl:classPredicate ct:Film ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                    swrl:argument1 <urn:swrl:var#f2> ;
                                    swrl:argument2 <urn:swrl:var#f1> ;
                                    swrl:propertyPredicate ct:sequelOf ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                            swrl:argument1 <urn:swrl:var#f1> ;
                                            swrl:argument2 <urn:swrl:var#d> ;
                                            swrl:propertyPredicate ct:directedBy ] ;
                                    rdf:rest [ a swrl:AtomList ;
                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                    swrl:argument1 <urn:swrl:var#f2> ;
                                                    swrl:argument2 <urn:swrl:var#d> ;
                                                    swrl:propertyPredicate ct:directedBy ] ;
                                            rdf:rest () ] ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 <urn:swrl:var#d> ;
                    swrl:classPredicate ct:SequelDirector ] ;
            rdf:rest () ] .

ct:SharedCollectionRule a swrl:Imp ;
    rdfs:label "SharedCollectionRule"^^xsd:string ;
    swrla:isRuleEnabled true ;
    rdfs:comment "Due film distinti della stessa collezione condividono il franchise (evita self-loop a differenza di una property chain)."@it ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 <urn:swrl:var#f1> ;
                    swrl:classPredicate ct:Film ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:ClassAtom ;
                            swrl:argument1 <urn:swrl:var#f2> ;
                            swrl:classPredicate ct:Film ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:DifferentIndividualsAtom ;
                                    swrl:argument1 <urn:swrl:var#f1> ;
                                    swrl:argument2 <urn:swrl:var#f2> ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                            swrl:argument1 <urn:swrl:var#f1> ;
                                            swrl:argument2 <urn:swrl:var#c> ;
                                            swrl:propertyPredicate ct:partOfCollection ] ;
                                    rdf:rest [ a swrl:AtomList ;
                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                    swrl:argument1 <urn:swrl:var#f2> ;
                                                    swrl:argument2 <urn:swrl:var#c> ;
                                                    swrl:propertyPredicate ct:partOfCollection ] ;
                                            rdf:rest () ] ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 <urn:swrl:var#f1> ;
                    swrl:argument2 <urn:swrl:var#f2> ;
                    swrl:propertyPredicate ct:sameCollectionAs ] ;
            rdf:rest () ] .

ct:StandardLengthFilm a owl:Class ;
    rdfs:label "Standard-length film"@en,
        "Film di durata standard"@it ;
    rdfs:comment "Film ⊓ ¬EpicFilm (owl:complementOf). Poiché runtime è FunctionalProperty, HermiT dimostra che i film con runtime < 150 appartengono a ¬EpicFilm, mentre lascia NON classificati i film privi di runtime (es. Insecta) per la Open World Assumption!"@it ;
    rdfs:subClassOf ct:Film ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ct:Film [ a owl:Class ;
                        owl:complementOf ct:EpicFilm ] ) ] .

ct:TMDB a ct:Fonte,
        owl:NamedIndividual ;
    rdfs:label "TMDB" .

